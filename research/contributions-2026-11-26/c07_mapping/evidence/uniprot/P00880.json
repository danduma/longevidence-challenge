{"entryType":"UniProtKB reviewed (Swiss-Prot)","primaryAccession":"P00880","uniProtkbId":"RBL_SYNP6","entryAudit":{"firstPublicDate":"1986-07-21","lastAnnotationUpdateDate":"2026-11-04","lastSequenceUpdateDate":"2005-02-15","entryVersion":179,"sequenceVersion":2},"annotationScore":5.0,"organism":{"scientificName":"Synechococcus sp. (strain ATCC 27144 / PCC 6301 / SAUG 1402/1)","commonName":"Anacystis nidulans","taxonId":269084,"lineage":["Bacteria","Bacillati","Cyanobacteriota","Cyanophyceae","Synechococcales","Synechococcaceae","Synechococcus"]},"proteinExistence":"1: Evidence at protein level","proteinDescription":{"recommendedName":{"fullName":{"value":"Ribulose bisphosphate carboxylase large chain"},"shortNames":[{"value":"RuBisCO large subunit"}],"ecNumbers":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"7922027"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"9882445"}],"value":"4.1.1.39"}]}},"genes":[{"geneName":{"value":"cbbL"},"synonyms":[{"value":"rbcA"},{"value":"rbcL"}],"orderedLocusNames":[{"value":"syc0130_c"}]}],"comments":[{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"7922027"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"9882445"}],"value":"RuBisCO catalyzes two reactions: the carboxylation of D-ribulose 1,5-bisphosphate, the primary event in carbon dioxide fixation, as well as the oxidative fragmentation of the pentose substrate in the photorespiration process. Both reactions occur simultaneously and in competition at the same active site"}],"commentType":"FUNCTION"},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"2 (2R)-3-phosphoglycerate + 2 H(+) = D-ribulose 1,5-bisphosphate + CO2 + H2O","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:23124"},{"database":"ChEBI","id":"CHEBI:15377"},{"database":"ChEBI","id":"CHEBI:15378"},{"database":"ChEBI","id":"CHEBI:16526"},{"database":"ChEBI","id":"CHEBI:57870"},{"database":"ChEBI","id":"CHEBI:58272"}],"ecNumber":"4.1.1.39