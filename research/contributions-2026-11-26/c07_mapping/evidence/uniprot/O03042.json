te + CO2 + H2O","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:23124"},{"database":"ChEBI","id":"CHEBI:15377"},{"database":"ChEBI","id":"CHEBI:15378"},{"database":"ChEBI","id":"CHEBI:16526"},{"database":"ChEBI","id":"CHEBI:57870"},{"database":"ChEBI","id":"CHEBI:58272"}],"ecNumber":"4.1.1.39","evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_01338"},{"evidenceCode":"ECO:0000305","source":"PubMed","id":"29372894"}]}},{"commentType":"CATALYTIC ACTIVITY","reaction":{"name":"D-ribulose 1,5-bisphosphate + O2 = 2-phosphoglycolate + (2R)-3-phosphoglycerate + 2 H(+)","reactionCrossReferences":[{"database":"Rhea","id":"RHEA:36631"},{"database":"ChEBI","id":"CHEBI:15378"},{"database":"ChEBI","id":"CHEBI:15379"},{"database":"ChEBI","id":"CHEBI:57870"},{"database":"ChEBI","id":"CHEBI:58033"},{"database":"ChEBI","id":"CHEBI:58272"}],"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_01338"},{"evidenceCode":"ECO:0000305","source":"PubMed","id":"29372894"}]}},{"commentType":"COFACTOR","cofactors":[{"name":"Mg(2+)","evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_01338"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"29372894"}],"cofactorCrossReference":{"database":"ChEBI","id":"CHEBI:18420"}}],"note":{"texts":[{"evidences":[{"evidenceCode":"ECO:0000255","source":"HAMAP-Rule","id":"MF_01338"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"29372894"}],"value":"Binds 1 Mg(2+) ion per subunit."}]}},{"texts":[{"evidences":[{"evidenceCode":"ECO:0000269","source":"PubMed","id":"21922322"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"29217567"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"29372894"},{"evidenceCode":"ECO:0000269","source":"PubMed","id":"35417702"}],"value":"Heterohexadecamer of 8 large chains and 8 small chains; disulfide-linked. Homodimer; disulfide-linked. The disulfide link is formed within the large subunit homodimers (PubMed:29372894). Interacts with RBCX1